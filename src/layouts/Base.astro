---
const { title = "BuilderStack — crypto dev tools, compared" } = Astro.props;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style>body{font-family:system-ui;max-width:960px;margin:auto;padding:1rem;background:#0b0e14;color:#e6e6e6}a{color:#7fd1ff}.card{border:1px solid #333;border-radius:8px;padding:1rem;margin:.5rem 0}.sp{border-color:#f5c542}nav a{margin-right:1rem}</style></head>
<body><nav><a href={`${import.meta.env.BASE_URL}`}>Home</a><a href={`${import.meta.env.BASE_URL}tools/`}>All tools</a><a href={`${import.meta.env.BASE_URL}sponsor/`}>Sponsor</a><a href={`${import.meta.env.BASE_URL}newsletter/`}>Newsletter</a></nav><slot/><footer><p><small>Sponsored placements are always labeled. Not financial advice.</small></p></footer></body></html>
