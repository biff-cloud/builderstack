---
const DEFAULT_DESC = "Vendor-neutral directory of crypto developer infrastructure — RPCs, indexers, security, wallets, oracles.";
const { title = "BuilderStack — crypto dev tools, compared", description = DEFAULT_DESC, canonicalPath } = Astro.props;
const site = Astro.site ?? new URL("https://biff-cloud.github.io");
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const sitemapHref = `${import.meta.env.BASE_URL}sitemap-index.xml`;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, site).href;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
<link rel="sitemap" href={sitemapHref}/>
<meta property="og:site_name" content="BuilderStack"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="BuilderStack: crypto dev tools, compared"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:image" content={ogImage}/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<style>body{font-family:system-ui;max-width:960px;margin:auto;padding:1rem;background:#0b0e14;color:#e6e6e6}a{color:#7fd1ff}.card{border:1px solid #333;border-radius:8px;padding:1rem;margin:.5rem 0}.sp{border-color:#f5c542}nav a{margin-right:1rem}pre{background:#151a23;padding:1rem;border-radius:8px;overflow-x:auto}</style></head>
<body><nav><a href={`${import.meta.env.BASE_URL}`}>Home</a><a href={`${import.meta.env.BASE_URL}tools/`}>All tools</a><a href={`${import.meta.env.BASE_URL}best/`}>Best by use case</a><a href={`${import.meta.env.BASE_URL}submit/`}>Submit a tool</a><a href={`${import.meta.env.BASE_URL}sponsor/`}>Sponsor</a><a href={`${import.meta.env.BASE_URL}newsletter/`}>Newsletter</a></nav><slot/><footer><p><small>Sponsored placements are always labeled. Rankings are never for sale. Not financial advice. · <a href={`${import.meta.env.BASE_URL}submit/`}>Submission guidelines</a></small></p></footer></body></html>
