---
// Paid Featured slots (see src/lib/featured.js). Renders nothing when no entry is active.
// Home: all active. Category page (category prop): active in that category. Guide page (guide prop): active entries whose "guide" matches.
import { activeFeatured } from "../lib/featured.js";
const {category,guide}=Astro.props;
const active=activeFeatured({category,guide});
---
{active.length>0 && <section class="featured" aria-label="Featured (paid placement)">{active.map(t=><div class="card sp featured-card"><span class="featured-label">Featured · paid placement</span><p><a href={`${import.meta.env.BASE_URL}tools/${t.slug}/`}><b>{t.name}</b></a>{t.verified && <>{" "}<span class="badge-verified" title="We signed up and ran the quickstart on this date">✓ Verified {t.verified}</span></>}</p><p>{t.desc}{" "}<small>({t.pricing})</small></p></div>)}</section>}
