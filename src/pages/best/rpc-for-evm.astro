---
import Base from "../../layouts/Base.astro"; import tools from "../../data/tools.json"; import Featured from "../../components/Featured.astro";
// Ethereum/EVM support checked on each vendor's Ethereum page (2026-10-16). Helius skipped: Solana-only. BlastAPI, Grove removed: discontinued.
const picks = [
  { slug: "alchemy", src: "https://www.alchemy.com/ethereum", note: "Ethereum plus major L2s; enhanced APIs and account abstraction on one key." },
  { slug: "quicknode", src: "https://www.quicknode.com/chains/eth", note: "Wide EVM chain list; streams and marketplace add-ons." },
  { slug: "infura", src: "https://www.infura.io/networks/ethereum", note: "Consensys-run; long-standing Ethereum and L2 endpoints." },
  { slug: "chainstack", src: "https://chainstack.com/build-better-with-ethereum/", note: "Managed EVM nodes; shared, dedicated or archive." },
  { slug: "getblock", src: "https://getblock.io/nodes/eth/", note: "Shared and dedicated Ethereum nodes." },
  { slug: "drpc", src: "https://drpc.org/chainlist/ethereum", note: "Decentralized gateway; public Ethereum endpoints." },
  { slug: "ankr", src: "https://www.ankr.com/docs/rpc-service/chains/chains-list/", note: "Public and premium RPC across many EVM chains." },
].map(p => ({ ...p, t: tools.find(t => t.slug === p.slug) })).filter(p => p.t);
---
<Base title="Best RPC providers for Ethereum & EVM — BuilderStack" description={`Ethereum and EVM RPC providers compared by free tier and limits: ${picks.map(p => p.t.name).join(", ")}.`}>
<h1>Best RPC providers for Ethereum & EVM</h1>
<p>{picks.length} RPC &amp; node providers from the directory that serve Ethereum mainnet and EVM chains. Order is editorial, not paid. Free tiers change, so verify on the vendor site.</p>
<Featured guide="rpc-for-evm"/>
<table style="width:100%;border-collapse:collapse;font-size:.95rem">
<thead><tr>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Provider</th>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Why</th>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Free tier</th>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Pricing</th>
</tr></thead>
<tbody>
{picks.map(p => (
<tr>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top"><a href={`${import.meta.env.BASE_URL}tools/${p.t.slug}/`}><b>{p.t.name}</b></a></td>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top">{p.note} <small><a href={p.src} rel="nofollow">Ethereum page</a></small></td>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top">{p.t.freeTier}</td>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top">{p.t.pricing}</td>
</tr>
))}
</tbody>
</table>
<p>Building on EVM? See also <a href={`${import.meta.env.BASE_URL}tools/foundry/`}>Foundry</a>, <a href={`${import.meta.env.BASE_URL}tools/ethers-js/`}>ethers.js</a> and <a href={`${import.meta.env.BASE_URL}best/indexer-for-evm/`}>the best EVM indexers</a>.</p>
<p><a href={`${import.meta.env.BASE_URL}compare/rpc-providers/`}>All RPC providers compared</a> · <a href={`${import.meta.env.BASE_URL}category/rpc-nodes/`}>← RPC &amp; Nodes</a></p>
</Base>
