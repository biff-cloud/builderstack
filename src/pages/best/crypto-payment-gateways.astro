---
import Base from "../../layouts/Base.astro"; import tools from "../../data/tools.json"; import Featured from "../../components/Featured.astro";
// Sources checked 2026-10-18: all source URLs return 200; BTCPay, Solana Pay (now solana-foundation/pay), Request Network repos not archived.
const picks = [
  { slug: "btcpay-server", src: "https://github.com/btcpayserver/btcpayserver", label: "Repo", note: "Self-hosted and open source, no processing fee; funds go straight to your own wallet. You run and maintain the server." },
  { slug: "solana-pay", src: "https://github.com/solana-foundation/pay", label: "Repo", note: "Open standard and JS SDK for SOL and USDC payments via QR codes and transaction requests; you build the checkout." },
  { slug: "request-network", src: "https://docs.request.network", label: "Docs", note: "Invoices, payment requests and payouts on several chains through one API, with webhooks for reconciliation." },
  { slug: "nowpayments", src: "https://nowpayments.io/pricing", label: "Pricing", note: "Hosted gateway API, invoices and widgets for many coins; quickest to integrate, with a per-transaction fee." },
  { slug: "coinpayments", src: "https://www.coinpayments.net/help-fees", label: "Fees", note: "Long-running hosted gateway with merchant API, shop plugins and batched withdrawals; per-transaction fees." },
].map(p => ({ ...p, t: tools.find(t => t.slug === p.slug) })).filter(p => p.t);
---
<Base title="Best crypto payment gateways and APIs — BuilderStack" description={`Crypto payment gateways and payment APIs for developers: ${picks.map(p => p.t.name).join(", ")}.`}>
<h1>Best crypto payment gateways and APIs</h1>
<p>{picks.length} picks: self-hosted and open-source options first, then hosted gateways. Order is editorial, not paid.</p>
<Featured guide="crypto-payment-gateways"/>
<table style="width:100%;border-collapse:collapse;font-size:.95rem">
<thead><tr>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Tool</th>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Why</th>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Free tier</th>
<th style="text-align:left;border-bottom:1px solid #333;padding:.4rem">Pricing</th>
</tr></thead>
<tbody>
{picks.map(p => (
<tr>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top"><a href={`${import.meta.env.BASE_URL}tools/${p.t.slug}/`}><b>{p.t.name}</b></a></td>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top">{p.note} <small><a href={p.src} rel="nofollow">{p.label}</a></small></td>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top">{p.t.freeTier}</td>
<td style="border-bottom:1px solid #222;padding:.4rem;vertical-align:top">{p.t.pricing}</td>
</tr>
))}
</tbody>
</table>
<p><a href={`${import.meta.env.BASE_URL}best/`}>All use-case guides</a> · <a href={`${import.meta.env.BASE_URL}category/payments/`}>← Payments</a></p>
</Base>
