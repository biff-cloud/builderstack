---
import Base from "../../layouts/Base.astro";
// Keep in sync with the pages in this folder.
const guides = [
  { path: "rpc-for-evm/", title: "Best RPC providers for Ethereum & EVM", note: "Managed and public RPC for Ethereum mainnet and EVM chains." },
  { path: "rpc-for-solana/", title: "Best RPC providers for Solana", note: "RPC and node providers with Solana support." },
  { path: "indexer-for-evm/", title: "Best indexers for EVM", note: "Frameworks and hosted services for custom EVM indexing." },
  { path: "crypto-market-data-apis/", title: "Best crypto market data APIs", note: "Price, market cap and exchange data for apps and bots." },
  { path: "smart-contract-security-tools/", title: "Best smart contract security tools", note: "Static analysis, fuzzing, formal verification and monitoring for Solidity." },
  { path: "block-explorers/", title: "Best block explorers and contract verification", note: "Etherscan, Blockscout, Sourcify, Solscan and self-hosted Otterscan." },
  { path: "crypto-payment-gateways/", title: "Best crypto payment gateways and APIs", note: "BTCPay Server, Solana Pay, Request Network, NOWPayments and CoinPayments." },
  { path: "wallet-screening/", title: "Best wallet blacklist and sanctions screening tools", note: "Check a wallet for USDT/USDC freezes and sanctions exposure: Eagle Virtual, FreezeRadar, Chainalysis oracle, TRM." },
];
---
<Base title="Best tools by use case — BuilderStack" description={`Curated picks by use case: ${guides.map(g => g.title).join("; ")}.`}>
<h1>Best tools by use case</h1>
<p>Short, curated lists for one job each, with free tiers and pricing pulled from the directory. Order is editorial, not paid.</p>
{guides.map(g => (
<div class="card"><a href={`${import.meta.env.BASE_URL}best/${g.path}`}><b>{g.title}</b></a><br/><small>{g.note}</small></div>
))}
<p><a href={`${import.meta.env.BASE_URL}compare/rpc-providers/`}>All RPC providers compared</a> · <a href={`${import.meta.env.BASE_URL}tools/`}>All tools</a></p>
</Base>
