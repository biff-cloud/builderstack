---
import Base from "../layouts/Base.astro"; import tools from "../data/tools.json"; import Featured from "../components/Featured.astro"; import { activeFeatured } from "../lib/featured.js";
const hasFeatured=activeFeatured().length>0;
const cats=[...new Set(tools.map(t=>t.category))];
const slug=(c)=>c.toLowerCase().replace(/[^a-z0-9]+/g,"-");
---
<Base description="BuilderStack: the curated, vendor-neutral directory of crypto developer infrastructure — RPC & nodes, indexing, security, wallets, oracles, SDKs and dev frameworks."><h1>BuilderStack</h1><p>The curated, vendor-neutral directory of developer infrastructure for crypto builders: RPCs, indexers, security, wallets, oracles.</p>
<Featured/>
{!hasFeatured && <div class="card sp"><b>Sponsored slot</b> — <a href={`${import.meta.env.BASE_URL}sponsor/`}>your tool here</a></div>}
<h2>Categories</h2><ul>{cats.map(c=><li><a href={`${import.meta.env.BASE_URL}category/${slug(c)}/`}>{c}</a> ({tools.filter(t=>t.category===c).length})</li>)}</ul>
<p><a href={`${import.meta.env.BASE_URL}compare/rpc-providers/`}>RPC providers compared →</a> · <a href={`${import.meta.env.BASE_URL}best/rpc-for-solana/`}>Best RPC for Solana →</a> · <a href={`${import.meta.env.BASE_URL}best/rpc-for-evm/`}>Best RPC for EVM →</a> · <a href={`${import.meta.env.BASE_URL}best/indexer-for-evm/`}>Best EVM indexers →</a> · <a href={`${import.meta.env.BASE_URL}best/crypto-market-data-apis/`}>Best market data APIs →</a> · <a href={`${import.meta.env.BASE_URL}best/smart-contract-security-tools/`}>Best security tools →</a> · <a href={`${import.meta.env.BASE_URL}best/block-explorers/`}>Best block explorers →</a> · <a href={`${import.meta.env.BASE_URL}best/crypto-payment-gateways/`}>Best crypto payment gateways →</a> · <a href={`${import.meta.env.BASE_URL}best/wallet-screening/`}>Best wallet screening tools →</a> · <a href={`${import.meta.env.BASE_URL}best/tokenized-stock-trackers/`}>Best tokenized stock trackers →</a> · <a href={`${import.meta.env.BASE_URL}best/crypto-futures-market-monitors/`}>Best crypto futures market monitors →</a></p>
<p><a href={`${import.meta.env.BASE_URL}newsletter/`}>Get the weekly builder-tools newsletter →</a></p></Base>
