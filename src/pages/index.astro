---
import Base from "../layouts/Base.astro"; import tools from "../data/tools.json";
const cats=[...new Set(tools.map(t=>t.category))];
const slug=(c)=>c.toLowerCase().replace(/[^a-z0-9]+/g,"-");
---
<Base><h1>BuilderStack</h1><p>The curated, vendor-neutral directory of developer infrastructure for crypto builders: RPCs, indexers, security, wallets, oracles.</p>
<div class="card sp"><b>Sponsored slot</b> — <a href={`${import.meta.env.BASE_URL}sponsor/`}>your tool here</a></div>
<h2>Categories</h2><ul>{cats.map(c=><li><a href={`${import.meta.env.BASE_URL}category/${slug(c)}/`}>{c}</a> ({tools.filter(t=>t.category===c).length})</li>)}</ul>
<p><a href={`${import.meta.env.BASE_URL}newsletter/`}>Get the weekly builder-tools newsletter →</a></p></Base>
