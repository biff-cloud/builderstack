---
import Base from "../../layouts/Base.astro"; import tools from "../../data/tools.json";
export function getStaticPaths(){return tools.map(t=>({params:{slug:t.slug},props:{t}}));}
const {t}=Astro.props;
if(t.verified&&!/^\d{4}-\d{2}-\d{2}$/.test(t.verified))throw new Error(`tools.json: ${t.slug} verified must be YYYY-MM-DD`);
---
<Base title={`${t.name} — BuilderStack`} description={`${t.name}: ${t.desc} Category: ${t.category}. Pricing: ${t.pricing}.`}>
<h1>{t.name}</h1>
{t.verified && <p class="verified" title="We signed up and ran the quickstart on this date"><b>Verified {t.verified}</b></p>}
<p>{t.desc}</p>
<p>Category: {t.category} · Pricing: {t.pricing}</p>
{t.freeTier && <p><b>Free tier:</b> {t.freeTier}</p>}
{t.limits && <p><b>Limits:</b> {t.limits}</p>}
<p><a href={t.url} rel="noopener">Visit {t.name} →</a></p>
</Base>
