---
import Base from "../../layouts/Base.astro"; import tools from "../../data/tools.json";
export function getStaticPaths(){return tools.map(t=>({params:{slug:t.slug},props:{t}}));}
const {t}=Astro.props;
---
<Base title={`${t.name} — BuilderStack`}><h1>{t.name}</h1><p>{t.desc}</p><p>Category: {t.category} · Pricing: {t.pricing}</p><p><a href={t.url} rel="noopener">Visit {t.name} →</a></p></Base>
