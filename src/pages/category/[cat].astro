---
import Base from "../../layouts/Base.astro"; import tools from "../../data/tools.json"; import Featured from "../../components/Featured.astro";
export function getStaticPaths(){const s=(c)=>c.toLowerCase().replace(/[^a-z0-9]+/g,"-");return [...new Set(tools.map(t=>t.category))].map(c=>({params:{cat:s(c)},props:{c}}));}
const {c}=Astro.props;
---
<Base title={`${c} — BuilderStack`} description={`${c} tools for crypto developers, compared on BuilderStack: ${tools.filter(t=>t.category===c).map(t=>t.name).join(", ")}.`}><h1>{c}</h1><Featured category={c}/>{c==="RPC & Nodes" && <p><a href={`${import.meta.env.BASE_URL}compare/rpc-providers/`}>RPC providers compared →</a> · <a href={`${import.meta.env.BASE_URL}best/rpc-for-solana/`}>Best RPC for Solana →</a> · <a href={`${import.meta.env.BASE_URL}best/rpc-for-evm/`}>Best RPC for EVM →</a></p>}{c==="Data & Indexing" && <p><a href={`${import.meta.env.BASE_URL}best/indexer-for-evm/`}>Best indexers for EVM →</a></p>}{c==="Trading & Market Data" && <p><a href={`${import.meta.env.BASE_URL}best/crypto-market-data-apis/`}>Best crypto market data APIs →</a></p>}{c==="Security" && <p><a href={`${import.meta.env.BASE_URL}best/smart-contract-security-tools/`}>Best smart contract security tools →</a></p>}{tools.filter(t=>t.category===c).map(t=><div class="card"><a href={`${import.meta.env.BASE_URL}tools/${t.slug}/`}><b>{t.name}</b></a> — {t.desc} <small>({t.pricing})</small></div>)}</Base>
