---
import Base from "../../layouts/Base.astro"; import tools from "../../data/tools.json";
export function getStaticPaths(){const s=(c)=>c.toLowerCase().replace(/[^a-z0-9]+/g,"-");return [...new Set(tools.map(t=>t.category))].map(c=>({params:{cat:s(c)},props:{c}}));}
const {c}=Astro.props;
---
<Base title={`${c} — BuilderStack`} description={`${c} tools for crypto developers, compared on BuilderStack: ${tools.filter(t=>t.category===c).map(t=>t.name).join(", ")}.`}><h1>{c}</h1>{c==="RPC & Nodes" && <p><a href={`${import.meta.env.BASE_URL}compare/rpc-providers/`}>RPC providers compared →</a></p>}{tools.filter(t=>t.category===c).map(t=><div class="card"><a href={`${import.meta.env.BASE_URL}tools/${t.slug}/`}><b>{t.name}</b></a> — {t.desc} <small>({t.pricing})</small></div>)}</Base>
